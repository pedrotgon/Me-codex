# Production only: keep Gemini credentials on the server and never expose them
# through Vite variables or client-side source. The private draft UI stores its
# test key locally in the user's browser.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
