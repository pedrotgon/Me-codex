{
  "$name": "Më Life OS Design Tokens",
  "$version": "2.0.0",
  "$description": "Design tokens para o Më Life OS inspirados na fusão editorial e de alta densidade da Boston Consulting Group (BCG) e Goldman Sachs.",
  "primitive": {
    "color": {
      "forest": {
        "50": { "$type": "color", "$value": "#f2f7f3", "$description": "Verde floresta muito sutil para backgrounds de destaque" },
        "100": { "$type": "color", "$value": "#e2efe4", "$description": "Verde floresta claro para tags e chips" },
        "200": { "$type": "color", "$value": "#c4dfc8", "$description": "Verde floresta suave para bordas em hover" },
        "300": { "$type": "color", "$value": "#97c69f", "$description": "Verde floresta intermediário" },
        "400": { "$type": "color", "$value": "#62a56f", "$description": "Verde floresta médio" },
        "500": { "$type": "color", "$value": "#41a217", "$description": "Verde acento BCG vívido para ações ativas e sucesso" },
        "600": { "$type": "color", "$value": "#297716", "$description": "Verde acento escurecido para hover" },
        "700": { "$type": "color", "$value": "#205d15", "$description": "Verde floresta profundo" },
        "800": { "$type": "color", "$value": "#164416", "$description": "Verde floresta denso" },
        "900": { "$type": "color", "$value": "#0c2b15", "$description": "Verde floresta canônico Më / BCG Deep Forest" },
        "950": { "$type": "color", "$value": "#05170b", "$description": "Verde floresta quase preto para sidebar e rodapé" }
      },
      "goldman": {
        "50": { "$type": "color", "$value": "#f0f5fa", "$description": "Azul gelo Goldman Sachs" },
        "100": { "$type": "color", "$value": "#dce8f4", "$description": "Azul claro Goldman Sachs para badges" },
        "200": { "$type": "color", "$value": "#bcd3eb", "$description": "Azul suave para divisores analíticos" },
        "300": { "$type": "color", "$value": "#94b8df", "$description": "Azul médio para gráficos" },
        "400": { "$type": "color", "$value": "#7399c6", "$description": "Azul assinatura Goldman Sachs para gráficos e foco analítico" },
        "500": { "$type": "color", "$value": "#4f7ba8", "$description": "Azul executivo" },
        "600": { "$type": "color", "$value": "#3c6189", "$description": "Azul profundo" },
        "700": { "$type": "color", "$value": "#2f4d6e", "$description": "Azul marinho intermediário" },
        "800": { "$type": "color", "$value": "#243c56", "$description": "Azul marinho escuro" },
        "900": { "$type": "color", "$value": "#1b365d", "$description": "Deep Navy Goldman Sachs executivo" },
        "950": { "$type": "color", "$value": "#0f2038", "$description": "Deep Navy ultra escuro" }
      },
      "neutral": {
        "0": { "$type": "color", "$value": "#ffffff", "$description": "Branco puro para cartões, superfícies e modais" },
        "50": { "$type": "color", "$value": "#fbfbfb", "$description": "Calm canvas off-white / nude BCG" },
        "100": { "$type": "color", "$value": "#f4f4f4", "$description": "Fundo de hover e áreas secundárias" },
        "200": { "$type": "color", "$value": "#e8e8e8", "$description": "Bordas sutis de painéis e cards" },
        "300": { "$type": "color", "$value": "#d9d9d9", "$description": "Divisores de tabela e linhas de grade" },
        "400": { "$type": "color", "$value": "#9e9e9e", "$description": "Ícones secundários e placeholders" },
        "500": { "$type": "color", "$value": "#696969", "$description": "Texto secundário / muted copy BCG/GS" },
        "600": { "$type": "color", "$value": "#4a4a4a", "$description": "Legendas densas e metadados" },
        "700": { "$type": "color", "$value": "#333333", "$description": "Subtítulos e labels" },
        "800": { "$type": "color", "$value": "#1f1f1f", "$description": "Texto principal em superfícies claras" },
        "900": { "$type": "color", "$value": "#070707", "$description": "Editorial ink ultra nítido" }
      },
      "feedback": {
        "success": { "$type": "color", "$value": "#41a217", "$description": "Sucesso / Aprovado" },
        "warning": { "$type": "color", "$value": "#d97706", "$description": "Alerta / Atenção" },
        "error": { "$type": "color", "$value": "#dc2626", "$description": "Erro / Rejeição / Ação destrutiva" },
        "info": { "$type": "color", "$value": "#7399c6", "$description": "Informação / Sugestão IA" }
      }
    },
    "spacing": {
      "0": { "$type": "dimension", "$value": "0px" },
      "1": { "$type": "dimension", "$value": "2px" },
      "2": { "$type": "dimension", "$value": "4px" },
      "3": { "$type": "dimension", "$value": "6px" },
      "4": { "$type": "dimension", "$value": "8px" },
      "5": { "$type": "dimension", "$value": "10px" },
      "6": { "$type": "dimension", "$value": "12px" },
      "8": { "$type": "dimension", "$value": "16px" },
      "10": { "$type": "dimension", "$value": "20px" },
      "12": { "$type": "dimension", "$value": "24px" },
      "16": { "$type": "dimension", "$value": "32px" },
      "20": { "$type": "dimension", "$value": "40px" },
      "24": { "$type": "dimension", "$value": "48px" },
      "32": { "$type": "dimension", "$value": "64px" }
    },
    "radius": {
      "none": { "$type": "dimension", "$value": "0px" },
      "xs": { "$type": "dimension", "$value": "4px" },
      "sm": { "$type": "dimension", "$value": "6px" },
      "md": { "$type": "dimension", "$value": "8px" },
      "lg": { "$type": "dimension", "$value": "10px", "$description": "Raio de card e botão padrão BCG/Më" },
      "xl": { "$type": "dimension", "$value": "14px" },
      "full": { "$type": "dimension", "$value": "9999px" }
    },
    "typography": {
      "fontFamily": {
        "sans": { "$type": "fontFamily", "$value": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" },
        "serif": { "$type": "fontFamily", "$value": "'Newsreader', 'Georgia', serif" },
        "mono": { "$type": "fontFamily", "$value": "'JetBrains Mono', Menlo, Monaco, Consolas, monospace" }
      },
      "fontSize": {
        "10": { "$type": "dimension", "$value": "10px" },
        "11": { "$type": "dimension", "$value": "11px" },
        "12": { "$type": "dimension", "$value": "12px" },
        "13": { "$type": "dimension", "$value": "13px" },
        "14": { "$type": "dimension", "$value": "14px" },
        "15": { "$type": "dimension", "$value": "15px" },
        "16": { "$type": "dimension", "$value": "16px" },
        "18": { "$type": "dimension", "$value": "18px" },
        "20": { "$type": "dimension", "$value": "20px" },
        "24": { "$type": "dimension", "$value": "24px" },
        "28": { "$type": "dimension", "$value": "28px" },
        "32": { "$type": "dimension", "$value": "32px" },
        "40": { "$type": "dimension", "$value": "40px" }
      },
      "fontWeight": {
        "regular": { "$type": "fontWeight", "$value": "400" },
        "medium": { "$type": "fontWeight", "$value": "500" },
        "semibold": { "$type": "fontWeight", "$value": "600" },
        "bold": { "$type": "fontWeight", "$value": "700" }
      },
      "lineHeight": {
        "tight": { "$type": "lineHeight", "$value": "1.2" },
        "snug": { "$type": "lineHeight", "$value": "1.35" },
        "normal": { "$type": "lineHeight", "$value": "1.5" },
        "relaxed": { "$type": "lineHeight", "$value": "1.65" }
      }
    },
    "shadow": {
      "subtle": { "$type": "shadow", "$value": "0 1px 2px rgba(0, 0, 0, 0.03)" },
      "card": { "$type": "shadow", "$value": "0 1px 3px rgba(0, 0, 0, 0.04), 0 1px 2px rgba(0, 0, 0, 0.02)" },
      "popover": { "$type": "shadow", "$value": "0 4px 12px rgba(0, 0, 0, 0.08), 0 1px 3px rgba(0, 0, 0, 0.04)" },
      "modal": { "$type": "shadow", "$value": "0 12px 32px rgba(0, 0, 0, 0.12), 0 2px 6px rgba(0, 0, 0, 0.04)" }
    }
  },
  "semantic": {
    "color": {
      "background": {
        "canvas": { "$type": "color", "$value": "{primitive.color.neutral.50}" },
        "surface": { "$type": "color", "$value": "{primitive.color.neutral.0}" },
        "surfaceMuted": { "$type": "color", "$value": "{primitive.color.neutral.100}" },
        "sidebar": { "$type": "color", "$value": "{primitive.color.forest.900}" },
        "header": { "$type": "color", "$value": "{primitive.color.neutral.0}" },
        "accent": { "$type": "color", "$value": "{primitive.color.forest.500}" },
        "accentSubtle": { "$type": "color", "$value": "{primitive.color.forest.50}" }
      },
      "text": {
        "primary": { "$type": "color", "$value": "{primitive.color.neutral.900}" },
        "secondary": { "$type": "color", "$value": "{primitive.color.neutral.500}" },
        "tertiary": { "$type": "color", "$value": "{primitive.color.neutral.400}" },
        "inverse": { "$type": "color", "$value": "{primitive.color.neutral.0}" },
        "brand": { "$type": "color", "$value": "{primitive.color.forest.900}" },
        "accent": { "$type": "color", "$value": "{primitive.color.forest.500}" }
      },
      "border": {
        "subtle": { "$type": "color", "$value": "{primitive.color.neutral.200}" },
        "strong": { "$type": "color", "$value": "{primitive.color.neutral.300}" },
        "brand": { "$type": "color", "$value": "{primitive.color.forest.900}" },
        "focus": { "$type": "color", "$value": "{primitive.color.goldman.400}" }
      },
      "status": {
        "success": { "$type": "color", "$value": "{primitive.color.feedback.success}" },
        "warning": { "$type": "color", "$value": "{primitive.color.feedback.warning}" },
        "error": { "$type": "color", "$value": "{primitive.color.feedback.error}" },
        "info": { "$type": "color", "$value": "{primitive.color.feedback.info}" }
      }
    }
  },
  "component": {
    "button": {
      "primary": {
        "bg": { "$type": "color", "$value": "{semantic.color.text.brand}" },
        "text": { "$type": "color", "$value": "{semantic.color.text.inverse}" },
        "hoverBg": { "$type": "color", "$value": "{primitive.color.forest.800}" },
        "radius": { "$type": "dimension", "$value": "{primitive.radius.lg}" }
      },
      "secondary": {
        "bg": { "$type": "color", "$value": "{semantic.color.background.surface}" },
        "text": { "$type": "color", "$value": "{semantic.color.text.primary}" },
        "border": { "$type": "color", "$value": "{semantic.color.border.subtle}" },
        "hoverBg": { "$type": "color", "$value": "{semantic.color.background.surfaceMuted}" },
        "radius": { "$type": "dimension", "$value": "{primitive.radius.lg}" }
      },
      "accent": {
        "bg": { "$type": "color", "$value": "{semantic.color.background.accent}" },
        "text": { "$type": "color", "$value": "{semantic.color.text.inverse}" },
        "radius": { "$type": "dimension", "$value": "{primitive.radius.lg}" }
      },
      "destructive": {
        "bg": { "$type": "color", "$value": "{semantic.color.status.error}" },
        "text": { "$type": "color", "$value": "{semantic.color.text.inverse}" },
        "radius": { "$type": "dimension", "$value": "{primitive.radius.lg}" }
      }
    },
    "card": {
      "bg": { "$type": "color", "$value": "{semantic.color.background.surface}" },
      "border": { "$type": "color", "$value": "{semantic.color.border.subtle}" },
      "radius": { "$type": "dimension", "$value": "{primitive.radius.lg}" },
      "shadow": { "$type": "shadow", "$value": "{primitive.shadow.card}" },
      "padding": { "$type": "dimension", "$value": "{primitive.spacing.6}" }
    },
    "input": {
      "bg": { "$type": "color", "$value": "{semantic.color.background.surface}" },
      "border": { "$type": "color", "$value": "{semantic.color.border.subtle}" },
      "focusBorder": { "$type": "color", "$value": "{semantic.color.border.focus}" },
      "text": { "$type": "color", "$value": "{semantic.color.text.primary}" },
      "placeholder": { "$type": "color", "$value": "{semantic.color.text.tertiary}" },
      "radius": { "$type": "dimension", "$value": "{primitive.radius.md}" }
    },
    "table": {
      "headerBg": { "$type": "color", "$value": "{semantic.color.background.surfaceMuted}" },
      "headerText": { "$type": "color", "$value": "{semantic.color.text.secondary}" },
      "rowBorder": { "$type": "color", "$value": "{semantic.color.border.subtle}" },
      "rowHoverBg": { "$type": "color", "$value": "{semantic.color.background.surfaceMuted}" }
    },
    "dialog": {
      "overlayBg": { "$type": "color", "$value": "rgba(0, 0, 0, 0.45)" },
      "bg": { "$type": "color", "$value": "{semantic.color.background.surface}" },
      "border": { "$type": "color", "$value": "{semantic.color.border.subtle}" },
      "radius": { "$type": "dimension", "$value": "{primitive.radius.xl}" },
      "shadow": { "$type": "shadow", "$value": "{primitive.shadow.modal}" }
    }
  }
}
